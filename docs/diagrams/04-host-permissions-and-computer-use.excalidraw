      "seed": 1677386479,
      "version": 1,
      "versionNonce": 1864888205,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1763800000000,
      "link": null,
      "locked": false,
      "text": "Apple Silicon ARM64 非变参滚轮与 Unicode 键入\nDarwin AAPCS64 下弃用变参旧接口，选用固定签名\nCGEventCreateScrollWheelEvent2 防止被调函数从栈读取垃圾值\nUTF-16LE 编码正确计算 Emoji 代理对，按 16 码元分块注入免输入法干扰",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "c3_arm64",
      "originalText": "Apple Silicon ARM64 非变参滚轮与 Unicode 键入\nDarwin AAPCS64 下弃用变参旧接口，选用固定签名\nCGEventCreateScrollWheelEvent2 防止被调函数从栈读取垃圾值\nUTF-16LE 编码正确计算 Emoji 代理对，按 16 码元分块注入免输入法干扰",
      "autoResize": true,
      "lineHeight": 1.25
    },

    {
      "id": "note_invariant_03",
      "type": "text",
      "x": 60.0,
      "y": 1368.0,
      "width": 1462.0,
      "height": 18.0,
      "angle": 0,
      "strokeColor": "#1864ab",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a0089",
      "roundness": null,
      "seed": 1280782016,
      "version": 1,
      "versionNonce": 1377023346,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1763800000000,
      "link": null,
      "locked": false,
      "text": "核心工程不变量：审批决定“允许改什么”（绑定文件 SHA-256 与 40 位 Git base_commit），双进程 HMAC 沙盒限制“测试运行时能碰什么”（禁网只读 + 防 sys.exit(0) 伪造），唯有真实通过套件验收才推进基线提交。",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,

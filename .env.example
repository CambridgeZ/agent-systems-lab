# demo 无需密钥；真实调用需显式 AGENT_PROVIDER=anthropic 或 AGENT_PROVIDER=openai。
AGENT_PROVIDER=demo
# 调度模式：inline（单进程协程）或 queue（由独立 agent-lab worker 进程基于租约与 epoch 消费）。
AGENT_LAB_DISPATCH=inline
ANTHROPIC_API_KEY=
# 填写你账户当前可用的模型 ID，不假设固定模型始终可用。
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
# 默认仅连接官方 API；若确需自定义网关，需显式设置 AGENT_ALLOW_CUSTOM_BASE_URL=1。
AGENT_ALLOW_CUSTOM_BASE_URL=0
# 默认仅监听本机。若配置 TOKEN，所有 /api 请求都需 Bearer token。
AGENT_LAB_TOKEN=
